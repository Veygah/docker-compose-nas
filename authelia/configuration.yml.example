server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: 'info'

identity_validation:
  reset_password:
    jwt_secret: '${AUTHELIA_JWT_SECRET}'

totp:
  issuer: '${BASE_HOSTNAME}'

webauthn:
  display_name: 'NAS'
  attestation_conveyance_preference: 'indirect'

authentication_backend:
  file:
    path: '/config/users_database.yml'
    password:
      algorithm: 'argon2'

session:
  secret: '${AUTHELIA_SESSION_SECRET}'
  cookies:
    - domain: '${BASE_HOSTNAME}'
      authelia_url: 'https://${AUTHELIA_HOSTNAME}'
      default_redirection_url: 'https://${SEERR_HOSTNAME}'

storage:
  encryption_key: '${AUTHELIA_STORAGE_ENCRYPTION_KEY}'
  local:
    path: '/config/db.sqlite3'

access_control:
  default_policy: 'deny'
  rules:
    - domain: '${SEERR_HOSTNAME}'
      policy: 'two_factor'

regulation:
  max_retries: 5
  find_time: '10 minutes'
  ban_time: '15 minutes'

notifier:
  filesystem:
    filename: '/config/notification.txt'
